<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Transcript · #Support-hellyoo.-#58</title>
  <style>
    :root {
      --bg-primary: #0f1117;
      --bg-secondary: #161b27;
      --bg-card: #1e2433;
      --bg-message: #1a1f2e;
      --bg-message-hover: #1e2435;
      --accent: #5865f2;
      --accent-glow: rgba(88, 101, 242, 0.25);
      --accent-2: #57f287;
      --text-primary: #e8eaf0;
      --text-secondary: #99aab5;
      --text-muted: #5a6a7a;
      --border: rgba(255,255,255,0.06);
      --border-accent: rgba(88,101,242,0.4);
      --shadow: 0 4px 24px rgba(0,0,0,0.4);
      --radius: 12px;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
      background: var(--bg-primary);
      color: var(--text-primary);
      min-height: 100vh;
      line-height: 1.6;
    }

    /* ── Header ── */
    .header {
      background: linear-gradient(135deg, #1e2433 0%, #161b27 100%);
      border-bottom: 1px solid var(--border-accent);
      padding: 32px 40px;
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(12px);
    }
    .header-inner {
      max-width: 960px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .header-icon {
      width: 52px; height: 52px;
      background: linear-gradient(135deg, var(--accent), #7289da);
      border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      font-size: 24px;
      box-shadow: 0 0 20px var(--accent-glow);
      flex-shrink: 0;
    }
    .header-text h1 {
      font-size: 1.4rem; font-weight: 700;
      color: var(--text-primary);
      letter-spacing: -0.3px;
    }
    .header-text .subtitle {
      font-size: 0.85rem; color: var(--text-secondary); margin-top: 2px;
    }
    .header-badge {
      margin-left: auto;
      background: var(--accent-glow);
      border: 1px solid var(--border-accent);
      color: #7289da;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 0.78rem; font-weight: 600;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }

    /* ── Layout ── */
    .layout { max-width: 960px; margin: 0 auto; padding: 32px 24px; display: grid; grid-template-columns: 1fr 280px; gap: 24px; }
    @media (max-width: 768px) { .layout { grid-template-columns: 1fr; } .sidebar { order: -1; } }

    /* ── Sidebar ── */
    .sidebar { display: flex; flex-direction: column; gap: 16px; }
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
    }
    .card-title {
      font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 1px; color: var(--text-muted); margin-bottom: 16px;
    }
    .stat-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .stat-label { font-size: 0.85rem; color: var(--text-secondary); }
    .stat-value { font-size: 0.85rem; font-weight: 600; color: var(--text-primary); }
    .stat-value.accent { color: var(--accent); }

    .participant { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .participant-avatar {
      width: 34px; height: 34px; border-radius: 50%;
      background: linear-gradient(135deg, var(--accent), #7289da);
      display: flex; align-items: center; justify-content: center;
      font-size: 0.85rem; font-weight: 700; flex-shrink: 0;
    }
    .participant-info { display: flex; flex-direction: column; }
    .participant-name { font-size: 0.85rem; font-weight: 600; color: var(--text-primary); }
    .participant-count { font-size: 0.75rem; color: var(--text-muted); }

    /* ── Messages ── */
    .messages-wrapper { min-width: 0; }
    .messages-title {
      font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 1px; color: var(--text-muted); margin-bottom: 16px;
      padding-bottom: 12px; border-bottom: 1px solid var(--border);
    }
    .message {
      display: flex; gap: 14px;
      padding: 10px 14px;
      border-radius: 8px;
      transition: background 0.15s;
      margin-bottom: 2px;
    }
    .message:hover { background: var(--bg-message-hover); }
    .message.bot-message { background: rgba(88,101,242,0.05); }
    .avatar {
      width: 38px; height: 38px; border-radius: 50%;
      background: linear-gradient(135deg, #5865f2, #7289da);
      display: flex; align-items: center; justify-content: center;
      font-size: 0.9rem; font-weight: 700; flex-shrink: 0;
      margin-top: 2px;
    }
    .avatar.bot { background: linear-gradient(135deg, var(--accent), #57f287); }
    .message-body { flex: 1; min-width: 0; }
    .message-header { display: flex; align-items: baseline; gap: 8px; margin-bottom: 3px; }
    .author-name { font-size: 0.9rem; font-weight: 700; color: var(--text-primary); }
    .author-name.bot-tag { color: var(--accent); }
    .bot-badge {
      font-size: 0.65rem; background: var(--accent); color: #fff;
      padding: 1px 5px; border-radius: 3px; font-weight: 700;
      letter-spacing: 0.3px; text-transform: uppercase;
    }
    .msg-time { font-size: 0.72rem; color: var(--text-muted); }
    .msg-content { font-size: 0.9rem; color: var(--text-primary); word-break: break-word; line-height: 1.55; }
    .msg-content a { color: #7289da; text-decoration: none; }
    .msg-content a:hover { text-decoration: underline; }

    /* ── Embeds ── */
    .embed {
      background: var(--bg-message);
      border-left: 4px solid var(--accent);
      border-radius: 0 8px 8px 0;
      padding: 14px 16px;
      margin-top: 8px;
      max-width: 480px;
    }
    .embed-author { font-size: 0.8rem; font-weight: 700; color: var(--text-secondary); margin-bottom: 6px; }
    .embed-title { font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin-bottom: 6px; }
    .embed-desc { font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 8px; line-height: 1.5; white-space: pre-wrap; }
    .embed-field { margin-top: 8px; }
    .embed-field-name { font-size: 0.78rem; font-weight: 700; color: var(--text-primary); margin-bottom: 2px; }
    .embed-field-value { font-size: 0.82rem; color: var(--text-secondary); }
    .embed-footer { font-size: 0.75rem; color: var(--text-muted); margin-top: 10px; padding-top: 8px; border-top: 1px solid var(--border); }
    .embed img { max-width: 100%; border-radius: 6px; margin-top: 8px; }

    /* ── Attachments ── */
    .attachment { margin-top: 8px; }
    .attachment img { max-width: 400px; max-height: 300px; border-radius: 8px; display: block; border: 1px solid var(--border); }
    .attachment-file {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 8px; padding: 8px 12px; margin-top: 4px;
      text-decoration: none; color: var(--text-secondary); font-size: 0.82rem;
    }
    .attachment-file:hover { border-color: var(--border-accent); color: var(--text-primary); }

    /* ── Date divider ── */
    .date-divider {
      display: flex; align-items: center; gap: 12px;
      margin: 20px 0 8px; font-size: 0.72rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted);
    }
    .date-divider::before, .date-divider::after {
      content: ''; flex: 1; height: 1px; background: var(--border);
    }

    /* ── Footer ── */
    .footer {
      text-align: center; padding: 32px 24px;
      font-size: 0.78rem; color: var(--text-muted);
      border-top: 1px solid var(--border);
    }
  </style>
</head>
